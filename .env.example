# Copy this file to ".env" and fill in YOUR OWN values.
# NEVER commit or upload the real .env file to GitHub.

# PostgreSQL connection (driver: psycopg v3)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/smartspend_db

# Used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_secret_key

# --- AI provider (optional: the app still works without it, using rule-based fallbacks) ---
AI_API_KEY=your_api_key
AI_MODEL=your_model

# Base URL of an OpenAI-compatible API. Default is Groq.
#   Groq   : https://api.groq.com/openai/v1
#   OpenAI : https://api.openai.com/v1
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://api.groq.com/openai/v1
